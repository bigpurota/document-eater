{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-docs/qwen-27b",
  "providers": {
    "local-docs": {
      "name": "Local Qwen for private documents",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen-27b": {
          "modelID": "models/Qwen3.8-27B-4bit",
          "name": "Qwen3.8 27B MLX 4-bit local",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "document-eater": {
        "type": "local",
        "command": ["uv", "run", "--no-sync", "document-eater-mcp"],
        "cwd": ".",
        "codemode": false
      }
    }
  }
}
