{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-docs/models/Qwen3.8-27B-4bit",
  "provider": {
    "local-docs": {
      "name": "Local Qwen for private documents",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "models/Qwen3.8-27B-4bit": {
          "name": "Qwen3.8 27B MLX 4-bit local",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "document-eater": {
      "type": "local",
      "command": ["uv", "run", "--no-sync", "document-eater-mcp"],
      "cwd": ".",
      "enabled": true
    }
  }
}
